#!/usr/bin/env sh
# Small stable client for Aura's Quickshell IPC target.
set -eu

case "${1:-}" in
  launcher|controlCenter|notifications|clipboard|power|close)
    quickshell -c material3ui ipc call material3ui "$1"
    ;;
  settings)
    shift
    quickshell -c material3ui ipc call material3ui settings "${1:-}"
    ;;
  wifi|bluetooth)
    [ "$#" -eq 2 ] || { echo "usage: auractl $1 <value>" >&2; exit 2; }
    aura-system "$1" "$2"
    quickshell -c material3ui ipc call material3ui "$1" "$2"
    ;;
  volume|brightness)
    [ "$#" -eq 2 ] || { echo "usage: auractl $1 <value>" >&2; exit 2; }
    quickshell -c material3ui ipc call material3ui "$1" "$2"
    ;;
  screenshot|record|battery|about)
    aura-system "$1"
    ;;
  wallpaper)
    [ "$#" -eq 2 ] || { echo 'usage: auractl wallpaper /path/to/image' >&2; exit 2; }
    aura-system wallpaper "$2"
    ;;
  *)
    echo 'usage: auractl {launcher|controlCenter|notifications|clipboard|power|close|settings [section]|wifi on|off|bluetooth on|off|volume 0-100|brightness 0-100}' >&2
    exit 2
    ;;
esac
