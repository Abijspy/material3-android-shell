# Maintainer: Abishek (Abijspy) <reachabishekr@gmail.com>
# Umbriel's portal backend (screen sharing, screenshots and input capture
# for apps), for Material3UI's installer, at the commit tested with the
# Umbriel beside it (packaging/umbriel)
pkgname=xdg-desktop-portal-umbriel-git
_commit=56951426eb9931db3f1c57348f226c2427fba4f3 # 2026-11-06
pkgver=0.0.0.r0.g5695142
pkgrel=1
pkgdesc='xdg-desktop-portal backend for the Umbriel compositor'
arch=(x86_64 aarch64)
url='https://github.com/noctalia-dev/xdg-desktop-portal-umbriel'
license=(MIT)
depends=(xdg-desktop-portal sdbus-cpp pipewire wayland libdrm mesa cairo tomlplusplus gtk4)
makedepends=(git meson ninja pkgconf wayland-protocols nlohmann-json)
provides=(xdg-desktop-portal-umbriel xdg-desktop-portal-impl)
conflicts=(xdg-desktop-portal-umbriel)
options=(!debug)
source=("portal::git+https://github.com/noctalia-dev/xdg-desktop-portal-umbriel.git#commit=$_commit")
sha256sums=(SKIP)

pkgver() {
    cd portal
    printf '0.0.0.r%s.g%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
    meson setup build portal --prefix=/usr --libexecdir=lib --buildtype=release --wrap-mode=nodownload -Dtests=false -Dpicker=enabled
    meson compile -C build
}

package() {
    meson install -C build --destdir "$pkgdir" --no-rebuild
    install -Dm644 portal/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
