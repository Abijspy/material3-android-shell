# Maintainer: Abishek (Abijspy) <reachabishekr@gmail.com>
# Built from the checkout around it by packaging/build-pkg.sh, which sets
# M3_SRC and M3_PKGVER, and M3_BUILD when update.sh has just compiled the
# shell (that build is packaged as it is)
pkgname=material3ui
pkgver=${M3_PKGVER:-0}
pkgrel=1
pkgdesc="A Material 3 desktop shell for Hyprland and niri"
arch=(x86_64 aarch64)
url="https://github.com/Abijspy/material3-android-shell"
license=(MIT)
depends=(wayland libglvnd pango cairo libxkbcommon systemd-libs libpulse librsvg gdk-pixbuf2 polkit pam fastfetch)
makedepends=(meson ninja wayland-protocols wlr-protocols nlohmann-json)
# The compositor is yours to pick: Hyprland, niri, or both
optdepends=('hyprland: a compositor to run on (0.55 or newer)'
            'niri: a compositor to run on (26.04 or newer; beta)'
            'hyprsunset: night light on Hyprland'
            'xwayland-satellite: X11 apps on niri'
            'xdg-desktop-portal-gnome: screen sharing on niri'
            'wf-recorder: screen recording'
            'ffmpeg: GIF recordings'
            'slurp: picking a region or a window to capture or share'
            'grim: screenshots, and screen previews when sharing'
            'xdg-desktop-portal-hyprland: screen sharing on Hyprland, with the shell'"'"'s picker'
            'noto-fonts: text in Indic and other scripts'
            'pacman-contrib: checking for updates (checkupdates)'
            'fwupd: firmware updates in Settings → Firmware'
            'flatpak: Flatpak apps, their updates and remotes'
            'bibata-cursor-theme-bin: the default cursor (AUR)')
backup=(etc/pam.d/material3ui)
options=(!debug)

build() {
    [[ -n "${M3_BUILD:-}" ]] && return
    local src="${M3_SRC:?build with packaging/build-pkg.sh}"
    meson setup "$srcdir/build" "$src/shell" --prefix=/usr --sysconfdir=/etc --buildtype=release
    meson compile -C "$srcdir/build"
}

package() {
    meson install -C "${M3_BUILD:-$srcdir/build}" --destdir "$pkgdir" --no-rebuild --quiet
    install -Dm644 "$M3_SRC/LICENSE" -t "$pkgdir/usr/share/licenses/$pkgname/"
}
