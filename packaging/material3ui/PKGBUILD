# Maintainer: Abishek (Abijspy) <reachabishekr@gmail.com>
# Built from the checkout around it by packaging/build-pkg.sh, which sets
# M3_SRC and M3_PKGVER, and M3_BUILD when update.sh has just compiled the
# shell (that build is packaged as it is)
pkgname=material3ui
pkgver=${M3_PKGVER:-0}
pkgrel=1
pkgdesc="A Material 3 desktop shell for niri"
arch=(x86_64 aarch64)
url="https://github.com/Abijspy/material3-android-shell"
license=(MIT)
depends=(niri wayland libglvnd pango cairo libxkbcommon systemd-libs libpulse librsvg gdk-pixbuf2 polkit pam fastfetch)
makedepends=(meson ninja wayland-protocols wlr-protocols nlohmann-json mpv libvterm poppler-glib)
# niri 26.04 or newer
optdepends=('material3ui-files: Files, the file manager'
            'material3ui-viewer: the image viewer'
            'material3ui-player: Videos, the video player'
            'material3ui-tasks: the Task Manager'
            'material3ui-terminal: the terminal'
            'material3ui-notes: Notes'
            'material3ui-pdf: the PDF viewer and editor'
            'material3ui-text: the text editor'
            'material3ui-store: Store'
            'material3ui-podcasts: Podcasts'
            'material3ui-imagewriter: Image Writer'
            'material3ui-fonts: Fonts'
            'material3ui-calculator: Calculator'
            'material3ui-recorder: Sound Recorder'
            'material3ui-backups: Backups'
            'material3ui-camera: Camera'
            'material3ui-disks: Disks'
            'material3ui-music: Music'
            'xwayland-satellite: X11 apps on niri'
            'xdg-desktop-portal-gnome: screen sharing on niri'
            'wf-recorder: screen recording'
            'ffmpeg: GIF recordings'
            'slurp: picking a region to capture'
            'grim: screenshots'
            'noto-fonts: text in Indic and other scripts'
            'pacman-contrib: checking for updates (checkupdates)'
            'fwupd: firmware updates in Settings → Firmware'
            'flatpak: Flatpak apps, their updates and remotes'
            'bibata-cursor-theme-bin: the default cursor (AUR)')
backup=(etc/pam.d/material3ui)
options=(!debug)

build() {
    [[ -n "${M3_BUILD:-}" ]] && return
    local src="${M3_SRC:?build with packaging/build-pkg.sh}"
    meson setup "$srcdir/build" "$src/shell" --prefix=/usr --sysconfdir=/etc --buildtype=release
    meson compile -C "$srcdir/build"
}

package() {
    # The shell and libmaterial3ui; each app is a package of its own
    meson install -C "${M3_BUILD:-$srcdir/build}" --destdir "$pkgdir" --no-rebuild --quiet --tags shell
    install -Dm644 "$M3_SRC/LICENSE" -t "$pkgdir/usr/share/licenses/$pkgname/"
}
