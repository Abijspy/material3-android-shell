# Maintainer: Abishek (Abijspy) <reachabishekr@gmail.com>
# Umbriel, the Noctalia project's compositor, for Material3UI's installer:
# it isn't in Arch's repositories or the AUR yet. Built at the commit the
# shell was tested with, since Umbriel changes as it's developed and a
# newer one may not suit the shell yet; packaging/umbriel/README says how
# to move it on
pkgname=umbriel-git
_commit=90f65cb9a060882c9853dcf97ea5981482db1d75 # 0.1.0, 2026-11-06
pkgver=0.1.0.r0.g90f65cb
pkgrel=1
pkgdesc='A Wayland compositor built on wlroots'
arch=(x86_64 aarch64)
url='https://github.com/noctalia-dev/umbriel'
license=(MIT)
depends=(wlroots0.20 wayland libxkbcommon libinput libei pixman libdrm libdisplay-info cairo pango tomlplusplus
         libxcb xcb-util-wm systemd-libs jemalloc lcms2 mesa libglvnd)
makedepends=(git meson ninja pkgconf wayland-protocols nlohmann-json)
optdepends=('xorg-xwayland: X11 apps'
            'xdg-desktop-portal-umbriel-git: screen sharing and screenshots for apps')
provides=(umbriel)
conflicts=(umbriel)
options=(!debug)
source=("umbriel::git+https://github.com/noctalia-dev/umbriel.git#commit=$_commit")
sha256sums=(SKIP)

pkgver() {
    cd umbriel
    printf '%s.r%s.g%s' "$(tr -d '[:space:]' <VERSION)" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
    # The final prefix at configure time: Umbriel compiles its data path in
    meson setup build umbriel --prefix=/usr --libexecdir=lib --buildtype=release --wrap-mode=nodownload -Dtests=disabled
    meson compile -C build
}

package() {
    meson install -C build --destdir "$pkgdir" --no-rebuild
    install -Dm644 umbriel/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
