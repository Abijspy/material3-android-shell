[Desktop Entry]
Type=Application
Name=Photos
GenericName=Image Viewer
Comment=Your pictures in a gallery: view, zoom, step through and edit them
Exec=material3ui-viewer %f
Icon=material3ui-viewer
Terminal=false
Categories=Graphics;Viewer;
Keywords=picture;photo;image;viewer;gallery;
MimeType=image/png;image/jpeg;image/webp;image/gif;image/bmp;image/svg+xml;image/tiff;image/avif;image/heif;image/jxl;image/x-icon;
StartupNotify=false
StartupWMClass=material3ui-viewer
