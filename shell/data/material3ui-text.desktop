[Desktop Entry]
Type=Application
Name=Text Editor
GenericName=Text Editor
Comment=Edit text files and code, in tabs, with find and replace
Exec=material3ui-text %F
Icon=material3ui-text
Terminal=false
Categories=Utility;TextEditor;Development;
Keywords=text;editor;txt;code;notepad;plain;
MimeType=text/plain;text/markdown;text/x-log;application/x-shellscript;text/x-python;text/x-csrc;text/x-chdr;text/x-c++src;text/x-c++hdr;application/json;application/xml;text/xml;text/css;text/csv;application/x-yaml;application/toml;text/x-ini;
StartupNotify=false
StartupWMClass=material3ui-text
Actions=new-window;

[Desktop Action new-window]
Name=New file
Exec=material3ui-text
