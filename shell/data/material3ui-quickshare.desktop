[Desktop Entry]
Type=Application
Name=Quick Share
GenericName=Send to a phone
Comment=Send files to Android phones and Chromebooks nearby
Exec=material3ui msg quickshare send %F
Icon=send-to
Categories=Utility;Network;FileTransfer;
Keywords=nearby;share;android;phone;send;transfer;
MimeType=application/octet-stream;image/jpeg;image/png;image/gif;image/webp;video/mp4;video/x-matroska;video/webm;audio/mpeg;audio/flac;audio/ogg;application/pdf;application/zip;text/plain;application/vnd.android.package-archive;
StartupNotify=false
