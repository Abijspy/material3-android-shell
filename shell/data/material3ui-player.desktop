[Desktop Entry]
Type=Application
Name=Videos
GenericName=Video Player
Comment=Play videos and music: every format, subtitles and web videos
Exec=material3ui-player %U
Icon=material3ui-player
Terminal=false
Categories=AudioVideo;Video;Player;
Keywords=video;movie;player;mpv;music;audio;subtitles;
MimeType=video/mp4;video/x-matroska;video/webm;video/quicktime;video/x-msvideo;video/mpeg;video/ogg;video/x-flv;video/3gpp;video/x-ms-wmv;video/mp2t;audio/mpeg;audio/flac;audio/ogg;audio/x-wav;audio/wav;audio/mp4;audio/aac;audio/opus;audio/x-vorbis+ogg;audio/webm;
StartupNotify=false
StartupWMClass=material3ui-player
