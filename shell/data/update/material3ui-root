#!/usr/bin/env bash
# Runs one root step through the update helper running for this update:
#   material3ui-root DIR COMMAND [ARG…]
# AUR helpers use it as their sudo (--sudo material3ui-root --sudoflags DIR).
DIR="${1:?usage: material3ui-root DIR COMMAND [ARG…]}"
shift
[[ -e "$DIR/ready" ]] || { echo "the update helper isn't running" >&2; exit 1; }
printf '%s\n' "$(printf '%s\0' "$@" | base64 -w0)" > "$DIR/in"
read -r code < "$DIR/out"
exit "${code:-1}"
